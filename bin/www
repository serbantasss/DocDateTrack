#!/usr/bin/env node

const fs = require('fs');
const http = require('http');
const https = require('https');
const mongoose = require('mongoose');

const mongoDB = process.env.MONGODB_URI;
if (!mongoDB) {
  throw new Error('MONGODB_URI must be set before starting the application');
}

if (!process.env.SESSION_SECRET) {
  throw new Error('SESSION_SECRET must be set before starting the application');
}

const httpPort = normalizePort(process.env.PORT || '8080');
const sslKeyPath = process.env.SSL_KEY_PATH;
const sslCertPath = process.env.SSL_CERT_PATH;

if (Boolean(sslKeyPath) !== Boolean(sslCertPath)) {
  throw new Error('Set both SSL_KEY_PATH and SSL_CERT_PATH to enable HTTPS');
}

async function start() {
  const httpsOptions = sslKeyPath && sslCertPath ? {
    key: fs.readFileSync(sslKeyPath),
    cert: fs.readFileSync(sslCertPath),
  } : null;

  await mongoose.connect(mongoDB);

  const app = require('../app');
  app.set('port', httpPort);
  const httpServer = http.createServer(app);
  await listen(httpServer, httpPort);
  httpServer.on('error', logServerError);
  logListening(httpServer, 'HTTP');

  if (httpsOptions) {
    const httpsPort = normalizePort(process.env.PORT_HTTPS || '8443');
    const httpsServer = https.createServer(httpsOptions, app);
    try {
      await listen(httpsServer, httpsPort);
    } catch (error) {
      await new Promise((resolve) => httpServer.close(resolve));
      throw error;
    }
    httpsServer.on('error', logServerError);
    logListening(httpsServer, 'HTTPS');
  }
}

function normalizePort(value) {
  const port = Number.parseInt(value, 10);
  return Number.isNaN(port) ? value : port >= 0 ? port : false;
}

function listen(server, port) {
  return new Promise((resolve, reject) => {
    const onError = (error) => {
      server.removeListener('listening', onListening);
      reject(error);
    };
    const onListening = () => {
      server.removeListener('error', onError);
      resolve();
    };

    server.once('error', onError);
    server.once('listening', onListening);
    server.listen(port);
  });
}

function logListening(server, protocol) {
  const address = server.address();
  const bind = typeof address === 'string' ? address : `port ${address.port}`;
  console.info(`${protocol} listening on ${bind}`);
}

function logServerError(error) {
  console.error('Server error:', error);
  process.exitCode = 1;
}

start().catch(async (error) => {
  console.error('Unable to start DocDateTrack:', error);
  await mongoose.disconnect().catch((disconnectError) => {
    console.error('Unable to close MongoDB connection:', disconnectError);
  });
  process.exitCode = 1;
});
