# DocDateTrack configuration: every setting with its default. Copy this file to `.env`, then adjust.
#
# - Node.js: `npm start`, `npm run dev` and the npm task scripts read `.env` from the project
#   directory. The values below are for local development.
# - Docker Compose reads `.env` from the directory that contains compose.yaml, but only for the
#   settings compose.yaml uses. The container always runs with NODE_ENV=production on port 8080,
#   with the bundled MongoDB and the uploads volume, so NODE_ENV, PORT, MONGODB_URI, UPLOAD_DIR
#   and the built-in HTTPS settings in this file do not apply to it. See "Docker Compose" below.
#
# Empty values use the defaults. Booleans accept true/false, 1/0 or yes/no. Keep comments on their
# own lines, and put values that contain spaces, # or $ in single quotes.

# --- Server ---------------------------------------------------------------
# development or production (production hides error details and caches views)
NODE_ENV=development
PORT=8080
# Address people use to open DocDateTrack, used for links in emails; no trailing slash.
# Default: http://localhost:<PORT>. Set it for email reminders and behind a reverse proxy.
APP_URL=
# Name shown in the interface and in emails
APP_NAME=DocDateTrack
# Request log format: dev, combined, common, short, tiny or none
# (default: dev in development, combined in production)
LOG_FORMAT=

# --- Database -------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27018/docdatetrack_dev
# Host port of the MongoDB container from compose.yaml (`docker compose up -d mongo`); keep it
# in sync with the port in MONGODB_URI
MONGODB_PORT=27018

# --- Sessions and security ------------------------------------------------
# Required. Generate one with: openssl rand -hex 32 (at least 32 characters in production)
SESSION_SECRET=
# Server-side session lifetime in hours ("remember me" sign-ins last 30 days)
SESSION_TTL_HOURS=12
# auto = secure cookies on HTTPS requests only; true = always (HTTPS required); false = never
COOKIE_SECURE=auto
# Behind a reverse proxy: a hop count (e.g. 1), true, or a comma-separated list of proxy IPs/subnets
TRUST_PROXY=false
# Let people create accounts themselves (the very first account can always be created)
ALLOW_REGISTRATION=false

# --- Documents ------------------------------------------------------------
# Where uploaded scans are stored; relative paths are resolved from the project directory
UPLOAD_DIR=uploads
# Maximum size of an uploaded file in megabytes
MAX_UPLOAD_MB=10
# Documents expiring within this many days are shown as "expiring soon" (also used by reminders)
EXPIRY_WARNING_DAYS=30
# Locale used to display dates (e.g. en-GB, en-US, de-DE)
DATE_LOCALE=en-GB

# --- Email reminders ------------------------------------------------------
REMINDERS_ENABLED=false
# When the reminder digest is sent (cron syntax: minute hour day month weekday, in time zone TZ)
REMINDER_CRON='0 8 * * *'
# Also email owners that have an email address
NOTIFY_OWNERS=false
# Either a connection URL (smtp:// or smtps://) or the host/port/user/password settings below
SMTP_URL=
SMTP_HOST=
# 587 with SMTP_SECURE=false (STARTTLS), or 465 with SMTP_SECURE=true (TLS)
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender address, e.g. 'DocDateTrack <docdatetrack@example.com>'.
# Default: "<APP_NAME> <no-reply@localhost>"
MAIL_FROM=

# --- Optional built-in HTTPS (not used by Docker Compose) -----------------
# Set both paths to also serve HTTPS on PORT_HTTPS (a reverse proxy is usually a better option)
SSL_KEY_PATH=
SSL_CERT_PATH=
PORT_HTTPS=8443

# --- Demo data ------------------------------------------------------------
# Password of the demo accounts created by `npm run db:seed` (only for databases whose name ends
# in _dev or _demo). Never use demo data on a real instance.
DEMO_USER_PASSWORD=LocalDemoOnly123!

# --- Docker Compose -------------------------------------------------------
# Used only by compose.yaml, together with MONGODB_PORT above.
# Image version to run: latest, a major version such as 1, or an exact version such as 1.0.0
DOCDATETRACK_VERSION=latest
# Host port of the web interface; 127.0.0.1:8080 accepts connections from this machine only
# (for example when a reverse proxy runs on the same host)
APP_PORT=8080
# Name of the database in the bundled MongoDB (docdatetrack_demo for a demo instance)
MONGODB_DATABASE=docdatetrack
# Time zone for the reminder schedule and for what counts as "today" (default in Docker: UTC).
# Node.js outside Docker uses the system time zone; set TZ to override it, but never leave it empty.
#TZ=Europe/Berlin
