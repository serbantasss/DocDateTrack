{
  "name": "docdatetrack",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted web app that tracks the expiry dates of important documents and reminds you before they lapse.",
  "keywords": [
    "documents",
    "expiry",
    "expiration",
    "reminders",
    "self-hosted",
    "express",
    "mongodb"
  ],
  "homepage": "https://github.com/serbantasss/DocDateTrack#readme",
  "bugs": {
    "url": "https://github.com/serbantasss/DocDateTrack/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/serbantasss/DocDateTrack.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env bin/www",
    "dev": "node --watch --env-file-if-exists=.env bin/www",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:seed": "node --env-file-if-exists=.env tasks/seed-demo-data.js",
    "db:migrate": "node --env-file-if-exists=.env tasks/migrate-legacy-data.js",
    "reminders:send": "node --env-file-if-exists=.env tasks/send-reminders.js",
    "uploads:check": "node --env-file-if-exists=.env tasks/check-uploads.js",
    "users": "node --env-file-if-exists=.env tasks/manage-users.js"
  },
  "dependencies": {
    "bootstrap": "~5.3.9",
    "bootstrap-icons": "^1.13.2",
    "compression": "^1.8.2",
    "connect-mongo": "^6.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "http-errors": "^2.0.1",
    "luxon": "^3.7.2",
    "method-override": "^3.0.0",
    "mongodb": "~7.9.1",
    "mongoose": "^9.13.0",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.6.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "passport-local-mongoose": "^9.2.1",
    "pug": "^3.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "mongodb-memory-server": "^11.4.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2"
  }
}
