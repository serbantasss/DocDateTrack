//- Base layout of the HTML emails. Locals: appName, appUrl, subject, preheader (optional).
//- Email clients drop <style> blocks and external CSS, so the styles are inline (the CSP rules
//- of the web pages do not apply to emails). Keep every value escaped (= and #{}, never != or !{}).
doctype html
html(lang='en')
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    meta(name='color-scheme' content='light')
    title= subject
  body(style='margin:0;padding:0;background-color:#f1f3f5;color:#212529;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Helvetica Neue,Arial,sans-serif;')
    if preheader
      div(style='display:none;max-height:0;overflow:hidden;opacity:0;')= preheader
    table(role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='background-color:#f1f3f5;')
      tr
        td(align='center' style='padding:24px 12px;')
          table(role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0' style='max-width:600px;background-color:#ffffff;border:1px solid #dee2e6;border-radius:8px;')
            tr
              td(style='padding:16px 24px;border-bottom:1px solid #dee2e6;font-size:18px;font-weight:bold;')
                a(href=`${appUrl}/` style='color:#212529;text-decoration:none;')= appName
            tr
              td(style='padding:24px;font-size:15px;line-height:1.5;')
                block content
            tr
              td(style='padding:16px 24px;border-top:1px solid #dee2e6;font-size:12px;line-height:1.5;color:#6c757d;')
                block footer
