//- Reminder digest. Locals (see composeReminderEmail in services/reminders.js): greeting, intro,
//- groups [{ label, color, items: [{ title, url, expiresOn, relative }] }], outstandingText,
//- footer (lines), plus the layout locals.
extends layout

block content
  p(style='margin:0 0 16px;')= greeting
  p(style='margin:0;')= intro
  each group in groups
    h2(style=`margin:24px 0 8px;font-size:16px;line-height:1.3;color:${group.color};`)= `${group.label} (${group.items.length})`
    table(role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0')
      each item in group.items
        tr
          td(style='padding:10px 0;border-top:1px solid #e9ecef;')
            a(href=item.url style='color:#0a58ca;font-weight:bold;text-decoration:none;')= item.title
            div(style='margin-top:2px;font-size:13px;color:#495057;') Expiry date: #{item.expiresOn} (#{item.relative})
  if outstandingText
    p(style='margin:16px 0 0;color:#495057;')= outstandingText
  p(style='margin:24px 0 0;')
    a(href=`${appUrl}/` style='display:inline-block;padding:10px 18px;border-radius:6px;background-color:#0d6efd;color:#ffffff;font-weight:bold;text-decoration:none;')= `Open ${appName}`

block footer
  each line in footer
    p(style='margin:0 0 4px;')= line
