//-
  Registration page. Locals: title, values { username, email, display_name },
  errors (express-validator `.mapped()`), isFirstUser.
  Posts `username`, `email`, `display_name`, `password`, `password_confirm` and `_csrf` to /register.
extends ../layouts/auth

block content
  if isFirstUser
    h1.h4.text-center.mb-3 Set up #{appName || 'DocDateTrack'}
    +alert('info', { title: 'Create the administrator account' })
      | This first account becomes the administrator, who can also manage other users.
  else
    h1.h4.text-center.mb-1 Create your account
    p.text-center.text-body-secondary.mb-4 Track the expiry dates of the documents that matter.
  +errorSummary()
  +form({ action: '/register' })
    +input({ name: 'username', label: 'Username', autocomplete: 'username', minlength: 3, maxlength: 50, pattern: '[A-Za-z0-9._\\-]+', required: true, help: '3–50 characters: letters, numbers, dots, hyphens and underscores.' })(autocapitalize='none' spellcheck='false')
    +input({ name: 'email', type: 'email', label: 'Email', autocomplete: 'email', maxlength: 254, required: true })
    +input({ name: 'display_name', label: 'Display name', autocomplete: 'name', maxlength: 100, help: 'Optional. Shown instead of your username.' })
    +input({ name: 'password', type: 'password', label: 'Password', autocomplete: 'new-password', minlength: 10, maxlength: 128, required: true, help: 'Use 10–128 characters. A long passphrase is easiest to remember.' })
    +input({ name: 'password_confirm', type: 'password', label: 'Confirm password', autocomplete: 'new-password', minlength: 10, maxlength: 128, required: true })
    +submit(isFirstUser ? 'Create administrator account' : 'Create account', { icon: 'person-plus', block: true, class: 'mt-3' })

block afterCard
  unless isFirstUser
    p.text-center.text-body-secondary.mt-4.mb-0
      | Already have an account? #[a(href='/login') Sign in]
