//-
  Sign-in page. Locals: title, values.username, allowRegistration.
  Posts `username` (username or email), `password`, `remember` ('1') and `_csrf` to /login;
  failed attempts come back as flash messages.
extends ../layouts/auth

block content
  h1.h4.text-center.mb-1 Sign in
  p.text-center.text-body-secondary.mb-4 Welcome back! Sign in to continue.
  +form({ action: '/login' })
    +input({ name: 'username', label: 'Username or email', autocomplete: 'username', maxlength: 254, required: true, autofocus: !(values && values.username) })(autocapitalize='none' spellcheck='false')
    +input({ name: 'password', type: 'password', label: 'Password', autocomplete: 'current-password', maxlength: 128, required: true, autofocus: Boolean(values && values.username) })
    +checkbox({ name: 'remember', value: '1', label: 'Keep me signed in' })
    +submit('Sign in', { icon: 'box-arrow-in-right', block: true, class: 'mt-3' })

block afterCard
  if allowRegistration
    p.text-center.text-body-secondary.mt-4.mb-0
      | New here? #[a(href='/register') Create an account]
