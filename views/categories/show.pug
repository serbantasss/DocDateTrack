//-
  Category detail. Locals: title, category, rows (findDocumentsWithStatus() rows sorted by
  urgency), summary (summarize(rows)).
extends ../layout
include ../mixins/documents

block content
  - var categoryDocumentsUrl = '/documents?category=' + category._id
  +pageHeader({ title: category.name, icon: 'tag', subtitle: 'Category', breadcrumbs: [{ label: 'Categories', href: '/categories' }] })
    +linkButton(`/documents/new?category=${category._id}`, 'Add document', { icon: 'file-earmark-plus', variant: 'primary' })
    +linkButton(`${category.url}/edit`, 'Edit', { icon: 'pencil-square' })
    if rows.length
      span.d-inline-block(tabindex='0' data-bs-toggle='tooltip' title='Categories that are used by documents cannot be deleted. Delete those documents first.')
        +deleteButton(category.url, { confirm: false })(disabled)
    else
      +deleteButton(category.url, { confirm: `Delete the category ${category.name}? This cannot be undone.` })

  .row.g-4
    .col-lg-4
      .card.mb-4
        .card-body
          h2.h6.card-title.mb-3 About this category
          dl.mb-0
            dt.small.fw-normal.text-body-secondary Scope
            dd
              +scopeBadge(category.scope)
            dt.small.fw-normal.text-body-secondary Description
            dd.mb-0.text-break
              if category.description
                each descriptionLine, descriptionIndex in category.description.split('\n')
                  if descriptionIndex
                    br
                  = descriptionLine
              else
                span.text-body-secondary No description

      .card.mb-4
        .card-body
          h2.h6.card-title.mb-3 Status
          ul.list-unstyled.mb-0
            each statusKey in ['expired', 'expiring', 'missing', 'valid']
              li.d-flex.justify-content-between.align-items-center.py-1
                +statusBadge(statusKey)
                if summary[statusKey]
                  - var statusCount = summary[statusKey]
                  a.fw-semibold.text-decoration-none(href=`${categoryDocumentsUrl}&status=${statusKey}` aria-label=`${statusCount}: show ${statusCount === 1 ? 'the document' : 'the documents'} with the status ${statusMeta[statusKey].label}`)= statusCount
                else
                  span.text-body-secondary 0

      p.small.text-body-secondary.mb-0
        | Added #{fmt.dateTime(category.createdAt)}
        if category.updatedAt && String(category.updatedAt) !== String(category.createdAt)
          br
          | Last changed #{fmt.dateTime(category.updatedAt)}

    .col-lg-8
      .card
        .card-header.d-flex.flex-wrap.justify-content-between.align-items-center.gap-2
          h2.h6.mb-0
            | Documents
            span.badge.rounded-pill.text-bg-secondary.ms-2= summary.total
          if rows.length
            a.small(href=categoryDocumentsUrl) Open in the document list
        if rows.length
          +documentsTable(rows, { showCategory: false, showScope: false, caption: `${category.name} documents` })
        else
          .card-body
            +emptyState({ icon: 'file-earmark-text', title: 'No documents yet', message: `No owner has a document of this category yet.`, action: { href: `/documents/new?category=${category._id}`, label: 'Add document', icon: 'file-earmark-plus' } })
